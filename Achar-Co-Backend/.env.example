PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/achar_co
# Set this to your exact deployed frontend origin, for example https://your-site.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
# Create a long unique password before deployment. Do not commit a real .env file.
ADMIN_EMAIL=admin@acharandco.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
